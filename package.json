{
  "name": "beauty-css",
  "version": "0.1.1",
  "description": "A lightweight CSS library for beautiful, readable websites.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Konstantin Zavarov",
    "url": "https://zavarov.com"
  },
  "homepage": "https://github.com/zavarovkv/beauty-css#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavarovkv/beauty-css.git"
  },
  "bugs": {
    "url": "https://github.com/zavarovkv/beauty-css/issues"
  },
  "keywords": [
    "css",
    "typography",
    "classless",
    "markdown",
    "dark-mode",
    "responsive"
  ],
  "style": "./dist/beauty.css",
  "exports": {
    ".": "./dist/beauty.css",
    "./prose": "./dist/beauty.prose.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "dev": "npm run build && npm run build:site && node scripts/serve.mjs",
    "test": "npm run build && npm run build:site && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lightningcss": "1.33.0",
    "parse5": "8.0.1",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "prettier": "3.9.10"
  }
}
